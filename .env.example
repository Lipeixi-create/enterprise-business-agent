# Setup/admin connection: only for init_db, generate_data and role setup.
# Never use this account in the API process.
DATABASE_URL=postgresql+psycopg://eba_admin:CHANGE_ME@localhost:5432/enterprise_business_agent

# Application connection: use the independent read-only role.
# Keep this commented for local SQLite development; the app then uses
# DATABASE_URL with mode=ro and PRAGMA query_only still enforced.
# READONLY_DATABASE_URL=postgresql+psycopg://eba_readonly:CHANGE_ME@localhost:5432/enterprise_business_agent

DATA_START=2024-01-01
DATA_MONTHS=24

QUERY_TIMEOUT_MS=15000
QUERY_MAX_ROWS=200
SQL_MAX_OFFSET=10000
API_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO

# Optional LLM planner/agent. Without a key, the deterministic rule planner is
# used and the API explicitly reports planner="rule"; it never fakes LLM success.
# Supported providers: anthropic (Messages API) and glm (OpenAI-compatible
# Chat Completions). The adapter is selected by LLM_PROVIDER; tool business
# logic is shared.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=CHANGE_ME
LLM_BASE_URL=https://api.anthropic.com/v1/messages
# GLM example:
#   LLM_PROVIDER=glm
#   LLM_MODEL=glm-5.3-flash
#   GLM_API_KEY=CHANGE_ME            # LLM_API_KEY / ZHIPU_API_KEY also accepted
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=4000
# Phase 9.2.1 reliability. The connect/read values also bound each HTTP
# attempt; the total per-request wall clock is LLM_TIMEOUT_SECONDS.
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=60
LLM_RETRY_BACKOFF_BASE_SECONDS=0.5
LLM_RETRY_BACKOFF_MAX_SECONDS=8
LLM_RETRY_AFTER_MAX_SECONDS=30
# 0 disables the breaker.
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RESET_SECONDS=30

# Phase 4 API authentication. Leave empty for local anonymous development.
# When set, every business endpoint requires X-API-Key.
# EBA_API_KEYS={"replace-with-a-long-random-key":"analyst"}
# EBA_API_KEY=
# EBA_API_ROLE=analyst
EBA_ALLOW_ANONYMOUS_API=true
# Role-level restrictions (metric, business domain, data resource, dimension,
# region). Region-restricted roles must filter every query to their regions.
# EBA_AUTHZ_POLICY={"restricted_analyst":{"metrics":["sales_amount"],"domains":["Sales"],"resources":["sales_fact"],"dimensions":["region"],"regions":["EC"]}}

AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_SECONDS=300
AGENT_MAX_TOTAL_TOKENS=120000
AGENT_TOOL_TIMEOUT_SECONDS=20
AGENT_TOOL_MAX_RETRIES=1
AGENT_MAX_CONSECUTIVE_FAILURES=2
AGENT_INVALID_ACTION_MAX_RETRIES=1
AGENT_LLM_MAX_RETRIES=1

# Durable agent run, audit and trace events. Defaults to a local SQLite file;
# point this at the application database in a multi-process deployment.
# RUN_STORE_URL=sqlite:///./enterprise_business_agent_runs.db
# RUN_STORE_URL=memory     # in-process only, not durable
# RUN_STORE_TTL_SECONDS=86400
#
# Phase 6 Batch 3 lifecycle, lease and retention budgets.
# A run may be resumed only while its whole-lifecycle wall clock is below this
# limit, even if the per-attempt budget is larger.
# AGENT_RUN_MAX_LIFECYCLE_SECONDS=3600
# Database claim lease for one worker; a crashed worker is taken over after it
# expires. Resume requests from a second live worker return HTTP 409.
# RUN_LEASE_SECONDS=60
# Status-specific cleanup TTL in seconds (0 disables waiting, not cleanup).
# RUN_RETENTION_COMPLETED_SECONDS=2592000
# RUN_RETENTION_FAILED_SECONDS=1209600
# RUN_RETENTION_CANCELLED_SECONDS=604800
# RUN_RETENTION_UNFINISHED_SECONDS=259200
# RUN_CLEANUP_DRY_RUN=false
# RUN_CLEANUP_BATCH_LIMIT=1000
#
# PostgreSQL runtime persistence (production):
#   1. The setup role creates every runtime table and grants the runtime role:
#        EBA_RUNTIME_SETUP_URL=postgresql+psycopg://eba_admin:CHANGE_ME@localhost:5432/enterprise_business_agent \
#        EBA_RUNTIME_ROLE=eba_runtime \
#        EBA_RUNTIME_PASSWORD=CHANGE_ME \
#        python scripts/init_runtime_store.py
#   2. The API then connects with the least-privilege runtime role:
#        RUN_STORE_URL=postgresql+psycopg://eba_runtime:CHANGE_ME@localhost:5432/enterprise_business_agent
# The runtime role has SELECT/INSERT/UPDATE/DELETE on agent_* tables only and
# never receives DDL rights. If PostgreSQL is unreachable or the schema is
# missing, startup fails; it never falls back to SQLite.
# EBA_RUNTIME_SETUP_URL (setup only) and EBA_RUNTIME_PASSWORD (setup only) must
# never be present in the API process environment.

# Optional OpenTelemetry tracing. Disabled by default; a tracing failure never
# affects the analysis. Install the optional dependencies with
#   pip install -e '.[otel]'
# Exporters:
#   otlp    - send to a collector / Jaeger at EBA_OTEL_EXPORTER_ENDPOINT
#   file    - append JSONL to EBA_OTEL_TRACE_FILE, view with
#             python scripts/view_traces.py data/traces/eba-spans.jsonl --attributes
#   console - print finished spans to stdout
#   none    - initialise the SDK without an exporter
# EBA_OTEL_ENABLED=false
# EBA_OTEL_SERVICE_NAME=enterprise-business-agent
# EBA_OTEL_EXPORTER=file
# EBA_OTEL_EXPORTER_ENDPOINT=http://127.0.0.1:4318/v1/traces
# EBA_OTEL_TRACE_FILE=data/traces/eba-spans.jsonl
# EBA_OTEL_SAMPLE_RATIO=1.0
# EBA_ENV=local

# Alert thresholds evaluated by GET /api/v1/alerts (admin scope only).
# EBA_ALERT_FAILURE_RATE=0.25
# EBA_ALERT_P95_SECONDS=300
# EBA_ALERT_PENDING_APPROVALS=10
# EBA_ALERT_MIN_RUNS=5

# MCP JSON-RPC transport at POST /mcp. Disabled by default so upgrading never
# exposes a new endpoint. MCP exposes only the existing read-only tools and
# every call still passes ToolRegistry scope checks, metric/region policy,
# AnalysisGateway, SemanticQueryGuard and SafeQueryExecutor.
# EBA_MCP_ENABLED=false
# MCP requires a valid X-API-Key even if anonymous API access is enabled.
# EBA_MCP_REQUIRE_API_KEY=true
# EBA_MCP_SERVER_NAME=enterprise-business-agent


{
  "version": "2.0.0",
  "grain_note": "All fact tables use period as the first day of the business month. Inventory snapshots are at region-product-month grain.",
  "metrics": [
    {
      "name": "revenue",
      "label": "营收",
      "synonyms": ["收入", "营业收入", "财务收入", "revenue", "total revenue"],
      "domain": "Finance",
      "description": "财务月度确认收入",
      "metric_type": "additive",
      "additivity": "additive",
      "source_table": "finance_monthly",
      "source_fields": ["period", "revenue"],
      "expression": "SUM(revenue)",
      "numerator": "SUM(revenue)",
      "denominator": null,
      "numerator_aggregation": "sum",
      "denominator_aggregation": "sum",
      "aggregation": "sum",
      "allowed_aggregations": ["sum", "avg"],
      "formula": "SUM(revenue)",
      "dimensions": ["region"],
      "time_grains": ["month", "quarter", "year", "total"],
      "unit": "CNY",
      "nullable_when": null,
      "zero_denominator": "null",
      "owner": "finance",
      "version": "2.0.0"
    },
    {
      "name": "sales_amount",
      "label": "销售额",
      "synonyms": ["销售收入", "销售金额", "sales", "sales amount", "sales revenue"],
      "domain": "Sales",
      "description": "销售事实的成交金额",
      "metric_type": "additive",
      "additivity": "additive",
      "source_table": "sales_fact",
      "source_fields": ["period", "sales_amount"],
      "expression": "SUM(sales_amount)",
      "numerator": "SUM(sales_amount)",
      "denominator": null,
      "numerator_aggregation": "sum",
      "denominator_aggregation": "sum",
      "aggregation": "sum",
      "allowed_aggregations": ["sum", "avg"],
      "formula": "SUM(sales_amount)",
      "dimensions": ["region", "channel", "product"],
      "time_grains": ["month", "quarter", "year", "total"],
      "unit": "CNY",
      "nullable_when": null,
      "zero_denominator": "null",
      "owner": "sales",
      "version": "2.0.0"
    },
    {
      "name": "sales_volume",
      "label": "销量",
      "synonyms": ["销售量", "销售件数", "units sold", "sales volume", "volume"],
      "domain": "Sales",
      "description": "销售事实的销售件数",
      "metric_type": "additive",
      "additivity": "additive",
      "source_table": "sales_fact",
      "source_fields": ["period", "units"],
      "expression": "SUM(units)",
      "numerator": "SUM(units)",
      "denominator": null,
      "numerator_aggregation": "sum",
      "denominator_aggregation": "sum",
      "aggregation": "sum",
      "allowed_aggregations": ["sum", "avg"],
      "formula": "SUM(units)",
      "dimensions": ["region", "channel", "product"],
      "time_grains": ["month", "quarter", "year", "total"],
      "unit": "units",
      "nullable_when": null,
      "zero_denominator": "null",
      "owner": "sales",
      "version": "2.0.0"
    },
    {
      "name": "gross_profit",
      "label": "毛利",
      "synonyms": ["毛利额", "利润", "gross profit"],
      "domain": "Finance",
      "description": "销售额减销售成本",
      "metric_type": "additive",
      "additivity": "additive",
      "source_table": "sales_fact",
      "source_fields": ["period", "sales_amount", "cogs_amount"],
      "expression": "SUM(sales_amount - cogs_amount)",
      "numerator": "SUM(sales_amount - cogs_amount)",
      "denominator": null,
      "numerator_aggregation": "sum",
      "denominator_aggregation": "sum",
      "aggregation": "sum_formula",
      "allowed_aggregations": ["sum", "avg"],
      "formula": "SUM(sales_amount - cogs_amount)",
      "dimensions": ["region", "channel", "product"],
      "time_grains": ["month", "quarter", "year", "total"],
      "unit": "CNY",
      "nullable_when": null,
      "zero_denominator": "null",
      "owner": "finance",
      "version": "2.0.0"
    },
    {
      "name": "gross_margin",
      "label": "毛利率",
      "synonyms": ["毛利率水平", "利润率", "gross margin", "gross margin rate"],
      "domain": "Finance",
      "description": "毛利除以销售额；跨维度按分子分母加权计算，不做比率简单平均",
      "metric_type": "ratio",
      "additivity": "non_additive",
      "source_table": "sales_fact",
      "source_fields": ["period", "sales_amount", "cogs_amount"],
      "expression": "SUM(sales_amount - cogs_amount) / NULLIF(SUM(sales_amount), 0)",
      "numerator": "SUM(sales_amount - cogs_amount)",
      "denominator": "SUM(sales_amount)",
      "numerator_aggregation": "sum",
      "denominator_aggregation": "sum",
      "aggregation": "ratio",
      "allowed_aggregations": ["ratio"],
      "formula": "(sales_amount - cogs_amount) / sales_amount",
      "dimensions": ["region", "channel", "product"],
      "time_grains": ["month", "quarter", "year", "total"],
      "unit": "ratio",
      "nullable_when": "sales_amount = 0",
      "zero_denominator": "null",
      "owner": "finance",
      "version": "2.0.0"
    },
    {
      "name": "net_profit",
      "label": "净利润",
      "synonyms": ["净利", "利润", "net profit", "net income"],
      "domain": "Finance",
      "description": "财务收入减去实际总费用；实际总费用包含销售成本与运营费用",
      "metric_type": "additive",
      "additivity": "additive",
      "source_table": "finance_monthly",
      "source_fields": ["period", "revenue", "actual_amount"],
      "expression": "SUM(revenue - actual_amount)",
      "numerator": "SUM(revenue - actual_amount)",
      "denominator": null,
      "numerator_aggregation": "sum",
      "denominator_aggregation": "sum",
      "aggregation": "sum_formula",
      "allowed_aggregations": ["sum", "avg"],
      "formula": "revenue - cogs_amount - operating_expense",
      "dimensions": ["region"],
      "time_grains": ["month", "quarter", "year", "total"],
      "unit": "CNY",
      "nullable_when": null,
      "zero_denominator": "null",
      "owner": "finance",
      "version": "2.0.0"
    },
    {
      "name": "net_margin",
      "label": "净利率",
      "synonyms": ["净利润率", "利润率", "net margin", "net profit margin"],
      "domain": "Finance",
      "description": "净利润除以营收；跨维度按分子分母加权计算",
      "metric_type": "ratio",
      "additivity": "non_additive",
      "source_table": "finance_monthly",
      "source_fields": ["period", "revenue", "actual_amount"],
      "expression": "SUM(revenue - actual_amount) / NULLIF(SUM(revenue), 0)",
      "numerator": "SUM(revenue - actual_amount)",
      "denominator": "SUM(revenue)",
      "numerator_aggregation": "sum",
      "denominator_aggregation": "sum",
      "aggregation": "ratio",
      "allowed_aggregations": ["ratio"],
      "formula": "(revenue - actual_amount) / revenue",
      "dimensions": ["region"],
      "time_grains": ["month", "quarter", "year", "total"],
      "unit": "ratio",
      "nullable_when": "revenue = 0",
      "zero_denominator": "null",
      "owner": "finance",
      "version": "2.0.0"
    },
    {
      "name": "marketing_spend",
      "label": "营销投入",
      "synonyms": ["营销费用", "市场费用", "投放金额", "marketing spend"],

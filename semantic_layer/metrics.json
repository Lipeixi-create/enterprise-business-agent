    {
      "name": "ROI",
      "label": "营销 ROI",
      "synonyms": ["营销ROI", "投资回报率", "投入产出比", "roi", "return on investment"],
      "domain": "Marketing",
      "description": "活动归因收入除以营销投入；跨维度按分子分母加权计算",
      "metric_type": "ratio",
      "additivity": "non_additive",
      "source_table": "marketing_fact",
      "source_fields": ["period", "attributed_revenue", "spend"],

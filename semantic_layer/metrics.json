    {
      "name": "inventory",
      "label": "期末库存量",
      "synonyms": ["库存", "库存量", "期末库存", "inventory", "ending inventory"],
      "domain": "Supply Chain",
      "description": "库存快照中的期末库存量；跨时间不可直接相加，应取期末值",
      "metric_type": "semi_additive",
      "additivity": "semi_additive",
      "source_table": "inventory_snapshot",
      "source_fields": ["period", "inventory_qty"],
      "expression": "SUM(inventory_qty)",
      "numerator": "SUM(inventory_qty)",
      "denominator": null,
      "numerator_aggregation": "sum",
      "denominator_aggregation": "sum",
      "aggregation": "sum",
      "allowed_aggregations": ["last"],
      "formula": "期末库存量",
      "dimensions": ["region", "product", "supplier"],
      "time_grains": ["month", "quarter", "year", "total"],
      "unit": "units",
      "nullable_when": null,
      "zero_denominator": "null",
      "owner": "supply_chain",
      "version": "2.0.0"
    },
    {
      "name": "demand_units",
      "label": "需求量",
      "synonyms": ["需求件数", "demand units", "demand"],
      "domain": "Supply Chain",
      "description": "未受缺货约束的原始需求件数，等于已售件数加缺货件数",
      "metric_type": "additive",
      "additivity": "additive",
      "source_table": "inventory_snapshot",
      "source_fields": ["period", "demand_units"],
      "expression": "SUM(demand_units)",
      "numerator": "SUM(demand_units)",
      "denominator": null,
      "numerator_aggregation": "sum",
      "denominator_aggregation": "sum",
      "aggregation": "sum",
      "allowed_aggregations": ["sum", "avg"],
      "formula": "units_sold + stockout_units",
      "dimensions": ["region", "product"],
      "time_grains": ["month", "quarter", "year", "total"],
      "unit": "units",
      "nullable_when": null,
      "zero_denominator": "null",
      "owner": "supply_chain",
      "version": "2.0.0"
    },
    {
      "name": "stockout_units",
      "label": "缺货件数",
      "synonyms": ["缺货量", "缺货数量", "stockout units"],
      "domain": "Supply Chain",
      "description": "因库存不足未能满足的需求件数",
      "metric_type": "additive",
      "additivity": "additive",
      "source_table": "inventory_snapshot",
      "source_fields": ["period", "stockout_units"],
      "expression": "SUM(stockout_units)",
      "numerator": "SUM(stockout_units)",
      "denominator": null,
      "numerator_aggregation": "sum",
      "denominator_aggregation": "sum",
      "aggregation": "sum",
      "allowed_aggregations": ["sum", "avg"],
      "formula": "SUM(stockout_units)",
      "dimensions": ["region", "product"],
      "time_grains": ["month", "quarter", "year", "total"],
      "unit": "units",
      "nullable_when": null,
      "zero_denominator": "null",
      "owner": "supply_chain",
      "version": "2.0.0"
    },
    {
      "name": "inventory_days",
      "label": "库存天数",
      "synonyms": ["库存周转天数", "days of inventory", "inventory days"],
      "domain": "Supply Chain",
      "description": "库存可覆盖的销售天数，按销量加权平均，避免小销量商品拉偏均值",
      "metric_type": "ratio",
      "additivity": "non_additive",
      "source_table": "inventory_snapshot",
      "source_fields": ["period", "inventory_days", "units_sold"],
      "expression": "SUM(inventory_days * units_sold) / NULLIF(SUM(units_sold), 0)",
      "numerator": "SUM(inventory_days * units_sold)",
      "denominator": "SUM(units_sold)",
      "numerator_aggregation": "sum",
      "denominator_aggregation": "sum",
      "aggregation": "weighted_average",
      "allowed_aggregations": ["ratio"],
      "formula": "inventory_qty / (units_sold / 30)",
      "dimensions": ["region", "product", "supplier"],
      "time_grains": ["month", "quarter", "year", "total"],
      "unit": "days",
      "nullable_when": "units_sold = 0",
      "zero_denominator": "null",
      "owner": "supply_chain",
      "version": "2.0.0"
    },
    {
      "name": "inventory_turnover",
      "label": "库存周转率",
      "synonyms": ["库存周转次数", "库存周转", "inventory turnover"],
      "domain": "Supply Chain",
      "description": "期间销量除以期间平均库存量；分母按月份平均，避免把库存余额直接相加",
      "metric_type": "ratio",
      "additivity": "non_additive",
      "source_table": "inventory_snapshot",
      "source_fields": ["period", "units_sold", "inventory_qty"],
      "expression": "SUM(units_sold) / NULLIF(AVG(inventory_qty), 0)",
      "numerator": "SUM(units_sold)",
      "denominator": "AVG(inventory_qty)",
      "numerator_aggregation": "sum",
      "denominator_aggregation": "avg",
      "aggregation": "ratio",
      "allowed_aggregations": ["ratio"],
      "formula": "units_sold / average(inventory_qty)",
      "dimensions": ["region", "product", "supplier"],
      "time_grains": ["month", "quarter", "year", "total"],
      "unit": "turns",
      "nullable_when": "average inventory = 0",
      "zero_denominator": "null",
      "owner": "supply_chain",
      "version": "2.0.0"
    },
    {
      "name": "stockout_rate",
      "label": "缺货率",
      "synonyms": ["缺货比例", "stockout rate", "out of stock rate"],
      "domain": "Supply Chain",
      "description": "缺货件数除以需求量；跨维度按分子分母加权计算",
      "metric_type": "ratio",
      "additivity": "non_additive",
      "source_table": "inventory_snapshot",
      "source_fields": ["period", "stockout_units", "demand_units"],
      "expression": "SUM(stockout_units) / NULLIF(SUM(demand_units), 0)",
      "numerator": "SUM(stockout_units)",
      "denominator": "SUM(demand_units)",
      "numerator_aggregation": "sum",
      "denominator_aggregation": "sum",
      "aggregation": "weighted_ratio",
      "allowed_aggregations": ["ratio"],
      "formula": "stockout_units / demand_units",
      "dimensions": ["region", "product"],
      "time_grains": ["month", "quarter", "year", "total"],
      "unit": "ratio",
      "nullable_when": "demand_units = 0",
      "zero_denominator": "null",
      "owner": "supply_chain",
      "version": "2.0.0"
    },

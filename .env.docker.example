# Copy to .env.docker and replace every value before running:
#   docker compose --env-file .env.docker up --build
# Never commit the real file. This example contains placeholders only.

# Business database (PostgreSQL container superuser for local Docker only).
POSTGRES_PASSWORD=change-me-local-postgres

# Separate runtime and read-only role passwords. Use long random values.
EBA_RUNTIME_PASSWORD=change-me-local-runtime
EBA_READONLY_PASSWORD=change-me-local-readonly

# JSON map of API key -> role. Generate long random keys; do not reuse this.
# Roles: analyst, restricted_analyst, viewer, admin, business_manager, approver.
EBA_API_KEYS={"change-me-analyst-key":"analyst","change-me-approver-key":"approver","change-me-admin-key":"admin"}

# Optional
EBA_MCP_ENABLED=false
EBA_OTEL_ENABLED=false
EBA_OTEL_EXPORTER=none
EBA_OTEL_EXPORTER_ENDPOINT=
EBA_LOG_LEVEL=INFO
EBA_SEED_DATA=false
